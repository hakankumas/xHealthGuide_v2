<script>
    function formatDate(dateString) {
        const date = new Date(dateString);
        const day = date.getDate();
        const months = [
            "Ocak",
            "Şubat",
            "Mart",
            "Nisan",
            "Mayıs",
            "Haziran",
            "Temmuz",
            "Ağustos",
            "Eylül",
            "Ekim",
            "Kasım",
            "Aralık",
        ];
        const month = months[date.getMonth()]; // Ay indeksinden ay ismini al
        const year = String(date.getFullYear()).slice(-2); // Son iki haneyi al
        return `${day} ${month} ${year}`;
    }
</script>
